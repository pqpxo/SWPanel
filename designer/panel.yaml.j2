# Generated by SWPanel for: {{ display_label }}
# Hardware settings below are fixed; edit the layout in the designer.
{% macro pos(e, ind) %}
{% if e.align != 'TOP_LEFT' %}
{{ ind }}align: {{ e.align }}
{% endif %}
{% if e.x %}
{{ ind }}x: {{ e.x }}
{% endif %}
{% if e.y %}
{{ ind }}y: {{ e.y }}
{% endif %}
{% endmacro %}
{% macro box_style(e) %}
{% if e.radius != theme.radius %}
            radius: {{ e.radius }}
{% endif %}
{% if e.bg != theme.tile %}
            bg_color: {{ e.bg|c }}
{% endif %}
{% if e.border != theme.border %}
            border_color: {{ e.border|c }}
{% endif %}
{% if e.shadow_width %}
            shadow_width: {{ e.shadow_width }}
            shadow_color: {{ e.shadow_color|c }}
            shadow_opa: {{ e.shadow_opa }}%
            shadow_offset_x: {{ e.shadow_offset_x }}
            shadow_offset_y: {{ e.shadow_offset_y }}
            shadow_spread: {{ e.shadow_spread }}
{% endif %}
{% endmacro %}
{% macro element(e) %}
{% if e.type == 'label' %}
        - label:
{{ pos(e, '            ') }}
            text_font: {{ e|fid(e.text_size) }}
            text_color: {{ e.text_color|c }}
            text: {{ e.text|q }}
{% elif e.type == 'icon' %}
        - label:
{{ pos(e, '            ') }}
            text_font: icons_{{ e.icon_size }}
            text_color: {{ e.icon_color|c }}
            text: {{ e.icon|glyph }}
{% elif e.type == 'wifi' %}
        - label:
            id: icon_{{ e.id }}
{{ pos(e, '            ') }}
            text_font: icons_{{ e.icon_size }}
            text_color: {{ theme.muted|c }}
            text: "\U000F05AA"
{% elif e.type == 'conn' %}
        - label:
            id: lbl_{{ e.id }}
{{ pos(e, '            ') }}
            text_font: {{ e|fid(e.text_size) }}
            text_color: {{ e.text_color|c }}
            text: "Connecting..."
{% elif e.type == 'page_button' %}
        - button:
            id: btn_{{ e.id }}
{{ pos(e, '            ') }}
            width: {{ e.w }}
            height: {{ e.h }}
{{ box_style(e) }}
            widgets:
              - label:
                  align: CENTER
                  text_font: {{ e|fid(e.text_size) }}
                  text_color: {{ e.text_color|c }}
                  text: {{ e|page_button_text }}
            on_short_click:
              - lvgl.page.show:
                  id: page_{{ e.target }}
                  animation: NONE
{% elif e.type == 'toggle' %}
        - button:
            id: btn_{{ e.id }}
{{ pos(e, '            ') }}
            width: {{ e.w }}
            height: {{ e.h }}
{% if e.show_state %}
            checkable: true
{% endif %}
{{ box_style(e) }}
{% if e.icon_color != theme.icon %}
            text_color: {{ e.icon_color|c }}
{% endif %}
{% if e.show_state and e.off_opacity != 100 %}
            opa: {{ e.off_opacity }}%
{% endif %}
{% if e.show_state and (e.bg_on != theme.tile_on or e.icon_color_on != theme.yellow or e.off_opacity != 100) %}
            checked:
{% if e.off_opacity != 100 %}
              opa: 100%
{% endif %}
{% if e.bg_on != theme.tile_on %}
              bg_color: {{ e.bg_on|c }}
{% endif %}
{% if e.icon_color_on != theme.yellow %}
              text_color: {{ e.icon_color_on|c }}
{% endif %}
{% endif %}
            widgets:
{% if e.icon %}
              - label:
                  align: CENTER
                  y: {{ e.h|scaled(-14, 102) }}
                  text_font: icons_{{ e.icon_size }}
                  text: {{ e.icon|glyph }}
              - label:
                  align: CENTER
                  y: {{ e.h|scaled(24, 102) }}
                  text_font: {{ e|fid(e.text_size) }}
                  text_color: {{ e.text_color|c }}
                  text: {{ e.text|q }}
{% else %}
              - label:
                  align: CENTER
                  text_font: {{ e|fid(e.text_size) }}
                  text_color: {{ e.text_color|c }}
                  text: {{ e.text|q }}
{% endif %}
            on_short_click:
              - homeassistant.action:
                  action: homeassistant.toggle
                  data:
                    entity_id: {{ e.entity }}
{% elif e.type == 'sensor' %}
        - obj:
            styles: status_tile
            scrollable: false
{{ pos(e, '            ') }}
            width: {{ e.w }}
            height: {{ e.h }}
{{ box_style(e) }}
            widgets:
              - label:
                  align: CENTER
                  y: {{ e.h|scaled(-28, 116) }}
                  text_font: icons_{{ e.icon_size }}
                  text_color: {{ e.icon_color|c }}
                  text: {{ e.icon|glyph }}
              - label:
                  align: CENTER
                  y: {{ e.h|scaled(6, 116) }}
                  text_font: {{ e|fid(e.text_size) }}
                  text_color: {{ e.text_color|c }}
                  text: {{ e.text|q }}
              - label:
                  id: lbl_{{ e.id }}
                  align: CENTER
                  y: {{ e.h|scaled(32, 116) }}
                  text_font: {{ e|fid(e.value_size) }}
                  text_color: {{ e.value_color|c }}
                  text: {{ e|sensor_placeholder }}
{% elif e.type == 'status' %}
        - obj:
{% if e.off_opacity != 100 %}
            id: tile_{{ e.id }}
{% endif %}
            styles: status_tile
            scrollable: false
{{ pos(e, '            ') }}
            width: {{ e.w }}
            height: {{ e.h }}
{{ box_style(e) }}
            widgets:
              - label:
                  id: icon_{{ e.id }}
                  align: CENTER
                  y: {{ e.h|scaled(-28, 116) }}
                  text_font: icons_{{ e.icon_size }}
                  text_color: {{ theme.muted|c }}
                  text: {{ e.on_icon|glyph }}
              - label:
                  align: CENTER
                  y: {{ e.h|scaled(8, 116) }}
                  text_font: {{ e|fid(e.text_size) }}
                  text_color: {{ e.text_color|c }}
                  text: {{ e.text|q }}
              - label:
                  id: lbl_{{ e.id }}_state
                  align: CENTER
                  y: {{ e.h|scaled(32, 116) }}
                  text_font: {{ e|fid(16) }}
                  text_color: {{ theme.muted|c }}
                  text: "--"
{% elif e.type == 'slider' %}
        - slider:
            id: sld_{{ e.id }}
{{ pos(e, '            ') }}
            width: {{ e.w }}
            height: {{ e.h }}
            min_value: 0
            max_value: 255
            value: 0
            bg_color: {{ e.bg|c }}
            indicator:
              bg_color: {{ e.bar_color|c }}
            knob:
              bg_color: {{ e.knob_color|c }}
            on_release:
              - homeassistant.action:
                  action: light.turn_on
                  data:
                    entity_id: {{ e.entity }}
                    brightness: !lambda 'return (int) x;'
{% elif e.type == 'image' %}
        - image:
{{ pos(e, '            ') }}
            width: {{ e.w }}
            height: {{ e.h }}
            src: {{ e|image_id }}
{% endif %}
{% endmacro %}

substitutions:
  name: {{ device.name }}
  friendly_name: {{ device.friendly_name|q }}

esphome:
  name: ${name}
  friendly_name: ${friendly_name}
{% if display == 'crowpanel_7' %}
  on_boot:
    # After the I2C bus starts, before the touch controller does
    priority: 800
    then:
      - lambda: |-
          // V3.0 boards reset the GT911 through a PCA9557 at 0x18. Older boards
          // don't have one, and these writes then fail harmlessly.
          auto write = [](uint8_t reg, uint8_t value) {
            uint8_t data[2] = {reg, value};
            id(i2c_bus)->write(0x18, data, 2);
          };
          write(0x03, 0x00);
          write(0x01, 0x00);
          delay(20);
          write(0x01, 0x01);
          delay(100);
          write(0x03, 0x02);
{% endif %}

logger:
  # DEBUG logs every touch sample over 115200 baud serial, which stalls the loop
  level: INFO

api:
  encryption:
    key: !secret api_encryption_key

ota:
  - platform: esphome
    encryption:
      key: !secret api_encryption_key

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password

{% if fonts or custom_fonts %}
# Fonts. Material Design Icons are pinned to v7.4.47, and only the icons this layout uses are built in.
font:
{% for size, glyphs in fonts %}
  - file: "https://raw.githubusercontent.com/Templarian/MaterialDesign-Webfont/v7.4.47/fonts/materialdesignicons-webfont.ttf"
    id: icons_{{ size }}
    size: {{ size }}
    bpp: 4
    glyphs:
{% for g in glyphs %}
      - "\U{{ g }}"
{% endfor %}
{% endfor %}
{% for f in custom_fonts %}
  - file: "gfonts://{{ f.family }}@{{ f.weight }}"
    id: {{ f.id }}
    size: {{ f.size }}
    bpp: 4
{% if f.glyphs %}
    glyphs:
{% for g in f.glyphs %}
      - {{ g|q }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

{% if images %}

# Downloaded from the designer when ESPHome compiles, so ESPHome must be able to reach it.
image:
{% for id, img in images.items() %}
  - platform: file
    id: {{ id }}
    file: {{ img.url|q }}
    resize: {{ img.w }}x{{ img.h }}
    type: RGB565
    transparency: {{ 'alpha_channel' if img.alpha else 'opaque' }}
{% endfor %}
{% endif %}

{% include 'hardware/' ~ display ~ '.yaml.j2' %}
{% if state_toggles or statuses %}

# Tiles light up whenever their entity isn't off/unavailable.
text_sensor:
{% for e in state_toggles %}
  - platform: homeassistant
    id: ha_{{ e.id }}
    entity_id: {{ e.entity }}
    on_value:
      - lvgl.widget.update:
          id: btn_{{ e.id }}
          state:
            checked: !lambda 'return x != "off" && x != "unavailable" && x != "unknown" && x != "standby";'
{% endfor %}
{% for e in statuses %}
  - platform: homeassistant
    id: ha_{{ e.id }}
    entity_id: {{ e.entity }}
    on_value:
      - if:
          condition:
            lambda: 'return x == {{ e.on_state|cstr }};'
          then:
{% if e.off_opacity != 100 %}
            - lvgl.widget.update:
                id: tile_{{ e.id }}
                opa: 100%
{% endif %}
            - lvgl.label.update:
                id: icon_{{ e.id }}
                text: {{ e.on_icon|glyph }}
                text_color: {{ e.on_color|c }}
            - lvgl.label.update:
                id: lbl_{{ e.id }}_state
                text: {{ e.on_text|q }}
                text_color: {{ e.on_color|c }}
          else:
{% if e.off_opacity != 100 %}
            - lvgl.widget.update:
                id: tile_{{ e.id }}
                opa: {{ e.off_opacity }}%
{% endif %}
            - lvgl.label.update:
                id: icon_{{ e.id }}
                text: {{ e.off_icon|glyph }}
                text_color: {{ e.off_color|c }}
            - lvgl.label.update:
                id: lbl_{{ e.id }}_state
                text: !lambda 'return x == {{ e.off_state|cstr }} ? std::string({{ e.off_text|cstr }}) : x;'
                text_color: {{ e.off_color|c }}
{% endfor %}
{% endif %}
{% if sensors or sliders %}

sensor:
{% for e in sensors %}
  - platform: homeassistant
    id: ha_{{ e.id }}
    entity_id: {{ e.entity }}
    on_value:
      - lvgl.label.update:
          id: lbl_{{ e.id }}
          text:
            format: {{ e|sensor_format }}
            args: [x]
{% endfor %}
{% for e in sliders %}
  # Home Assistant has no brightness while the light is off
  - platform: homeassistant
    id: ha_{{ e.id }}
    entity_id: {{ e.entity }}
    attribute: brightness
    on_value:
      - lvgl.slider.update:
          id: sld_{{ e.id }}
          value: !lambda 'return isnan(x) ? 0 : x;'
{% endfor %}
{% endif %}
{% if wifis or conns %}

# Wi-Fi icon and connection text
interval:
  - interval: 5s
    then:
{% if wifis %}
      - if:
          condition:
            wifi.connected:
          then:
{% for e in wifis %}
            - lvgl.label.update:
                id: icon_{{ e.id }}
                text: "\U000F05A9"
                text_color: {{ theme.green|c }}
{% endfor %}
          else:
{% for e in wifis %}
            - lvgl.label.update:
                id: icon_{{ e.id }}
                text: "\U000F05AA"
                text_color: {{ theme.red|c }}
{% endfor %}
{% endif %}
{% if conns %}
      - if:
          condition:
            # Only Home Assistant subscribes to states; the ESPHome log viewer doesn't count
            api.connected:
              state_subscription_only: true
          then:
{% for e in conns %}
            - lvgl.label.update:
                id: lbl_{{ e.id }}
                text: "Home Assistant Connected"
{% endfor %}
          else:
{% for e in conns %}
            - lvgl.label.update:
                id: lbl_{{ e.id }}
                text: "Home Assistant Disconnected"
{% endfor %}
{% endif %}
{% endif %}

lvgl:
  displays: tft
  touchscreens: touch
{% if display == 'waveshare_35' %}
  # Landscape. Try 270 if the image is upside down.
  rotation: 90
  # No PSRAM on a WROOM-32: draw in 1/8-screen strips (~38 KB)
  buffer_size: 12%
{% endif %}
  bg_color: {{ theme.bg|c }}
  theme:
    button:
      bg_color: {{ theme.tile|c }}
      border_color: {{ theme.border|c }}
      border_width: 1
      radius: {{ theme.radius }}
      shadow_width: 0
      text_color: {{ theme.icon|c }}
      pressed:
        bg_color: {{ theme.tile_pressed|c }}
      checked:
        bg_color: {{ theme.tile_on|c }}
        text_color: {{ theme.yellow|c }}
  style_definitions:
    - id: status_tile
      bg_color: {{ theme.tile|c }}
      border_color: {{ theme.border|c }}
      border_width: 1
      radius: {{ theme.radius }}
      pad_all: 0
  pages:
{% for page in pages %}
    - id: page_{{ page.id }}
      bg_color: {{ page.bg|c }}
      pad_all: 0
      scrollable: false
      widgets:
{% for e in page.elements %}
{{ element(e) }}
{% endfor %}
{% if not page.elements %}
        - label:
            text: ""
{% endif %}
{% endfor %}
